[Unit]
Description=Install the stored remote-access password for tluser
# The hash comes out of /home/tluser, which the initramfs restored before the
# pivot, so there is nothing to wait for here beyond the filesystem. Same
# shape as dbrrg-ssh-hostkeys.service, which reads the host keys from the same
# restored home.
After=local-fs.target
Before=ssh.service

# Deliberately no Before= on anything in sysinit.target. This unit is
# WantedBy=multi-user.target and so implicitly After=basic.target, which comes
# after sysinit.target: a Before= on a sysinit unit would order it both before
# and after the same target, and systemd breaks that cycle by deleting a job
# on every boot. Two instances of exactly this have shipped in this repo; see
# CLAUDE.md, "A multi-user.target unit must never declare Before= on a
# sysinit.target unit".

[Service]
Type=oneshot
ExecStart=/usr/bin/dbrrg-password --apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
# last line
