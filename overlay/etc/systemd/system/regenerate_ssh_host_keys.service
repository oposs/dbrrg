[Unit]
Description=Regenerate SSH host keys
# ssh.socket must be ordered here too, not just ssh.service. On 26.04 sshd is
# socket-activated: ssh.socket listens from sockets.target and only then pulls
# in ssh.service on the first connection. Ordering against ssh.service alone
# would let the socket accept a connection before any host key exists, and
# ssh.service's own `sshd -t` precondition would fail that first login.
Before=ssh.service ssh.socket

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A -v
# Note: this self-disable is a no-op across reboots. The root filesystem is a
# read-only squashfs with a ZRAM overlay, so the symlink removal lives only in
# RAM and is gone at the next boot. Host keys are therefore regenerated every
# boot by design, which means SSH clients will report a changed host key each
# time - use StrictHostKeyChecking=no, or persist the keys under /config on
# the EFI partition the way machine-id already is.
ExecStartPost=/bin/systemctl disable regenerate_ssh_host_keys

[Install]
WantedBy=multi-user.target
# last line
