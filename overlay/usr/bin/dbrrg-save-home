#!/bin/sh
set -e

# Locations, overridable so test/integration/test-save-home.sh can run this
# script unprivileged.
DBRRG_STATE_DIR="${DBRRG_STATE_DIR:-/run/dbrrg/state}"
DBRRG_CMDLINE="${DBRRG_CMDLINE:-/proc/cmdline}"

# The ESP the initramfs mounted and deliberately left mounted. mount-squashfs.sh
# mounts it read-write and dbrrg-cleanup.sh says, in a comment, not to unmount
# it. It is by construction the partition this boot read, so writing here means
# the save and the restore cannot disagree.
#
# The old code mounted the EFI-SYSTEM partlabel symlink under /dev/disk on
# /boot/efi instead. Every dbrrg stick carries that partlabel, so with a second
# stick plugged in the symlink could resolve to the OTHER stick and the user's
# home was written there. It also mounted the same vfat filesystem a second time.
DBRRG_EFI_MOUNT="${DBRRG_EFI_MOUNT:-/run/dbrrg/storage/efi}"
DBRRG_EXCLUDE_DEFAULT="${DBRRG_EXCLUDE_DEFAULT:-/etc/dbrrg/save-home-exclude}"

# Exit codes, read by dbrrg-menu to tell the user what happened:
#
#   0  home saved
#   1  the resolved home directory is missing or is not a directory
#   2  this boot's home restore failed, so saving would destroy the good copy
#   3  the boot server is unreachable
#   4  this machine has no known place to store a home
#   5  the save was attempted and failed
#
# Everything except 1 used to be 0, and the no-target branch printed "home
# saved" while storing nothing.

# The directory to archive, which is NOT $HOME.
#
# upgrade-image re-execs itself under sudo and then calls this script from
# that root process. sudo runs with `Defaults env_reset` and no env_keep for
# HOME, so HOME becomes the target user's: `su - tluser -c "sudo printenv
# HOME"` prints /root on this image. A save triggered by `sudo upgrade-image`
# therefore ran `cd /root` and wrote a tar of root's dotfiles over
# /boot/efi/home.tar.gz. /root holds a .bashrc, so the archive had a valid
# member and dbrrg_restore_home_from_file accepted it on the next boot,
# replacing the user's home and the SSH host keys staged in
# ~/.dbrrg-ssh-host-keys, with no error printed anywhere.
DBRRG_HOME_DIR="${DBRRG_HOME_DIR:-$(getent passwd tluser | cut -d: -f6)}"
: "${DBRRG_HOME_DIR:=/home/tluser}"
if [ ! -d "$DBRRG_HOME_DIR" ]; then
  echo "dbrrg: $DBRRG_HOME_DIR is not a directory - refusing to save, so" >&2
  echo "       the stored home is not overwritten with something else." >&2
  exit 1
fi
# Prefer the base the initramfs actually built the fetch URL from.
#
# The sed below is kept only as a fallback, and it is wrong in a way worth
# naming: the greedy .* backtracks to the LAST slash anywhere in
# /proc/cmdline, so any kernel parameter appearing after ramroot= that
# contains a "/" - root=/dev/sda1, init=/sbin/init - yields a base with that
# parameter's text glued on. Today's configs/syslinux.cfg has no such
# parameter after ramroot=, so this has never fired, but adding one would
# silently orphan every netboot client's home. Reading the recorded value
# removes the whole class.
#
# The `|| true` is load-bearing, not decoration. A failed command
# substitution in an assignment ends the script under `set -e`, and
# restore_home() records boot-home-base only on the netboot branch
# (dbrrg-lib.sh:323-357). Without it, a USB machine died here on the second
# line of this script and saved nothing at logout, losing that session's
# changes and never persisting its SSH host keys.
BASE_PATH=$(cat "$DBRRG_STATE_DIR/boot-home-base" 2>/dev/null || true)
if [ -z "$BASE_PATH" ]; then
  BASE_PATH=$(cat "$DBRRG_CMDLINE" | sed -n 's/.*ramroot=\(.*\)\/.*$/\1/p')
fi

# Prefer the MAC the initramfs actually used to fetch this machine's home.
# Re-deriving it here (kernel ifindex 2) agreed with the restore only while
# both ran in the booted system; the restore now runs in the initramfs,
# which loads a smaller driver set and can therefore see a different ifindex
# order. Posting the archive under a different MAC than it was fetched with
# would silently orphan it. The old expression stays as a fallback for a
# boot where nothing was recorded.
MAC_ADDR=$(cat "$DBRRG_STATE_DIR/boot-mac" 2>/dev/null || true)
if [ -z "$MAC_ADDR" ]; then
  MAC_ADDR=$(cat /sys/class/net/$(ip  addr show  | sed -n 's/^2: *\([^: ]*\).*$/\1/p')/address 2>/dev/null || true)
fi
BOOT_SRV=$(cat "$DBRRG_CMDLINE" | sed -n 's/.*ramroot=http.*\/\/\([^/:]*\).*/\1/p')
# wait for dns to come up
#systemctl --user stop pulseaudio.service
#systemctl --user stop pulseaudio.socket
#systemctl --user disable pulseaudio.service
#systemctl --user disable pulseaudio.socket
cd "$DBRRG_HOME_DIR"

# Build the tar exclude list.
#
# The archive is unpacked SYNCHRONOUSLY by the initramfs on every boot, so
# everything in it is paid for at every startup. A NUC7i3BNK's home held a
# 233MB Claude Code binary and a large ~/.cache: a 22MB archive became several
# hundred MB and every boot got slower.
#
# `set --` builds a real argument list rather than a string, so a pattern
# containing a space stays one pattern. A string split by the shell would
# break every path with a space in it.
EXCLUDE_FILE="$DBRRG_HOME_DIR/.save-home-exclude"
[ -r "$EXCLUDE_FILE" ] || EXCLUDE_FILE="$DBRRG_EXCLUDE_DEFAULT"
set --
if [ -r "$EXCLUDE_FILE" ]; then
  while IFS= read -r _dsh_pat || [ -n "$_dsh_pat" ]; do
    # Skip blanks and comments. An empty pattern would become a bare
    # --exclude=, which matches nothing or everything depending on tar
    # version - either way not what the file says.
    case "$_dsh_pat" in
      ''|'#'*) continue ;;
    esac
    set -- "$@" "--exclude=$_dsh_pat"
  done <"$EXCLUDE_FILE"
fi

# Refuse to overwrite a good archive with a home we failed to restore.
#
# restore_home cannot abort the boot - a non-zero return there bricks the
# machine - so it records its outcome instead. Without this gate, a boot
# where the archive was unreachable or corrupt comes up with the shipped
# default home, dbrrg-ssh-hostkeys generates fresh host keys into it, and
# this script then uploads that default over the user's real home: their
# data and the machine's stable SSH identity destroyed in one step.
#
# "absent" is NOT a failure - it is a first boot, or a machine whose home was
# never saved, and saving is exactly right there. Only "failed" blocks.
#
# A missing marker means an initramfs that predates this mechanism; fall
# through to saving, which is the old behaviour.
DBRRG_RESTORE_STATE=$(cat "$DBRRG_STATE_DIR/home-restore" 2>/dev/null || true)
if [ "$DBRRG_RESTORE_STATE" = "failed" ]; then
  echo "dbrrg: home restore FAILED this boot - refusing to save, so the" >&2
  echo "       stored home and SSH host keys are not overwritten with a" >&2
  echo "       default one. Investigate before logging out again." >&2
  exit 2
fi

# Capture the live SSH host keys into the home directory so they travel with
# the archive. This is the ONLY place they are persisted - see
# /usr/bin/dbrrg-ssh-hostkeys and CLAUDE.md.
sudo /usr/bin/dbrrg-ssh-hostkeys --stage || true
if [ "" != "$BOOT_SRV" ]; then
  # Bounded, not "while true": an unreachable server at logout used to hang
  # the session forever - zero labwc keybindings and no menu mean the only
  # way out was a VT or a power cycle, and a power cycle loses this
  # session's home AND its freshly staged host keys. ~60s (60 * 1s sleep)
  # gives a flaky network a real chance while still bounding the wait.
  _dsh_waited=0
  _dsh_reachable=0
  while [ "$_dsh_waited" -lt 60 ]; do
    ping -nc 1 $BOOT_SRV 2>&1 >/dev/null && { _dsh_reachable=1; break; }
    sleep 1
    _dsh_waited=$((_dsh_waited + 1))
  done
  if [ "$_dsh_reachable" -ne 1 ]; then
    echo "dbrrg: boot server $BOOT_SRV unreachable after ${_dsh_waited}s -" >&2
    echo "       refusing to save. An upload that cannot reach its target" >&2
    echo "       cannot work; retry once the network is back." >&2
    exit 3
  fi
  # GNU tar exits 1 for "file changed as we read it", which is normal for a
  # live home; only status 2 and above is a failed archive.
  #
  # tar runs as root, as on the USB branch below. As tluser, one file in the
  # home that tluser cannot read (a root-owned 600 file left by a sudo
  # command) made tar exit 2 and failed every netboot save with exit 5, while
  # USB machines saved the same home fine. The archive is written through a
  # redirect by this shell, so the temporary file stays tluser's to remove.
  _dsh_rc=0
  sudo tar --warning=no-file-changed "$@" -zcf - . >"/tmp/$$.tar.gz" || _dsh_rc=$?
  if [ "$_dsh_rc" -gt 1 ]; then
    rm -f "/tmp/$$.tar.gz"
    echo "dbrrg: could not archive $DBRRG_HOME_DIR - nothing was uploaded." >&2
    exit 5
  fi
  # -f: without it curl exits 0 on an HTTP 4xx/5xx reply (413, 500, full
  # disk) and this script would report "home saved" for an upload the server
  # rejected, breaking the exit-5 contract.
  if ! curl -f -sS -F "data=@/tmp/$$.tar.gz" "${BASE_PATH}/home.pkg?mac=${MAC_ADDR}"; then
    rm -f "/tmp/$$.tar.gz"
    echo "dbrrg: upload to ${BASE_PATH} failed - your home was NOT saved." >&2
    exit 5
  fi
  rm -f "/tmp/$$.tar.gz"
# mountpoint, not -d: the initramfs creates the directory on every boot,
# netboot included, so an unmounted one would take the archive into RAM and
# report "home saved".
elif mountpoint -q "$DBRRG_EFI_MOUNT"; then
  # Write beside the live archive and rename over it only once the new one is
  # known good.
  #
  # The old code was `tar zcf - . | sudo dd of=/boot/efi/home.tar.gz`, which
  # truncates the only copy of the user's home BEFORE writing a byte. A power
  # cut or a full ESP mid-write left a broken archive, and the next boot came
  # up with an empty home: no SSH host keys, no WireGuard key, no settings.
  #
  # Writing tar -f directly also removes a second hole: /bin/sh has no
  # pipefail, so `tar | dd` only ever tested dd's status, and a tar that died
  # mid-stream still looked like a successful save.
  #
  # Every write to the ESP goes through sudo: the initramfs mounts it with a
  # plain `mount -t vfat` and no uid= option, so it is root:root 0755 and
  # tluser cannot create files there. tar still runs in the home directory, so
  # the members stay relative.
  _dsh_new="$DBRRG_EFI_MOUNT/home.tar.gz.new"
  if ! sudo rm -f "$_dsh_new"; then
    echo "dbrrg: could not clear the staging file - your home was NOT saved," >&2
    echo "       and the previous archive is untouched." >&2
    exit 5
  fi
  # Status 1 is "file changed as we read it", normal for a live home; gzip -t
  # below still guards integrity. Only 2 and above is a failed archive.
  _dsh_rc=0
  sudo tar --warning=no-file-changed "$@" -zcf "$_dsh_new" . || _dsh_rc=$?
  if [ "$_dsh_rc" -gt 1 ]; then
    sudo rm -f "$_dsh_new" || true
    echo "dbrrg: could not write the archive - your home was NOT saved, and" >&2
    echo "       the previous one is untouched." >&2
    exit 5
  fi
  # Verify before committing. A truncated gzip is exactly what a full ESP
  # produces, and restore_home would accept a file that merely exists.
  if ! sudo gzip -t "$_dsh_new"; then
    sudo rm -f "$_dsh_new" || true
    echo "dbrrg: the new archive is corrupt - your home was NOT saved, and" >&2
    echo "       the previous one is untouched." >&2
    exit 5
  fi
  if ! sudo mv -f "$_dsh_new" "$DBRRG_EFI_MOUNT/home.tar.gz"; then
    sudo rm -f "$_dsh_new" || true
    echo "dbrrg: could not replace the stored archive - your home was NOT" >&2
    echo "       saved, and the previous one is untouched." >&2
    exit 5
  fi
  sudo sync || true
else
  echo "dbrrg: this machine has no boot server and no mounted EFI partition," >&2
  echo "       so there is nowhere to store your home directory. Nothing was" >&2
  echo "       saved." >&2
  exit 4
fi
echo "home saved"
